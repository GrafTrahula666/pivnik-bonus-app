LIVE_MODE=live
PORT=4317
LIVE_BIND=127.0.0.1
LIVE_PUBLIC_ORIGIN=https://halloween.example.ru
LIVE_DATABASE_URL=
# JSON array: name, role (owner/operator/scanner/screen), passwordHash.
# Generate a different password hash for each account with npm run password.
LIVE_ACCOUNTS_JSON=
# Only behind exactly one trusted reverse proxy; bind the application privately.
LIVE_TRUST_PROXY=0
# Off unless explicitly configured and tested with the canonical authenticated API.
LIVE_ENABLE_REWARD_BRIDGE=false
LIVE_REWARD_API_ORIGIN=
LIVE_REWARD_SESSION_TOKEN=
