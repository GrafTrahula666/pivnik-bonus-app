# Public HTTPS hostname on a server reachable from Russia.
GATEWAY_DOMAIN=api.example.ru

# Browser traffic reaches this RU gateway. The gateway then uses the existing
# Vercel relay because direct Selectel -> Railway TLS is unreliable from RU.
# The relay reaches the same current VK production backend/database.
RAILWAY_ORIGIN=https://pivnik-vk-proxy.vercel.app

# Optional exact extra browser origins, comma-separated.
# Native VK Hosting (*.pages.vk-apps.com / *.pages.vk-apps.ru) is allowed automatically.
GATEWAY_ALLOWED_ORIGINS=

UPSTREAM_TIMEOUT_MS=20000
MAX_BODY_BYTES=8388608
