PORT=3000
NODE_ENV=development
DATABASE_URL=
SESSION_SECRET=
IDENTITY_TOMBSTONE_SECRET=

TELEGRAM_BOT_TOKEN=
OWNER_TELEGRAM_ID=
OWNER_TELEGRAM_USERNAME=
ANNA_TELEGRAM_ID=
TELEGRAM_APP_URL=https://pivnik-bonus-app-production-df60.up.railway.app
# Halloween invite links: https://t.me/<bot>/<mini app short name>?startapp=inv_<code> (Mini App registered in BotFather /newapp)
