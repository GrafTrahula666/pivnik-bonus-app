VK_APP_SECRET=
VK_COMMUNITY_ID=
VK_COMMUNITY_TOKEN=
VK_API_VERSION=5.199
OWNER_VK_ID=
VK_APP_URL=https://pivnik-vk-test-production-3474.up.railway.app
PIVNIK_ALLOWED_ORIGINS=https://pivnik-vk-proxy.vercel.app

# Public legal details. These defaults are also embedded in the release build;
# Railway variables may override them without changing source code.
LEGAL_OPERATOR_NAME="Индивидуальный предприниматель Иживильгин Виталий Викторович"
LEGAL_OPERATOR_ID="ИНН 380415014659"
LEGAL_CONTACT_EMAIL="origtopg666@gmail.com"
LEGAL_OPERATOR_ADDRESS="г. Санкт-Петербург, проспект Энгельса, д. 55"
LEGAL_DATA_RETENTION_POLICY="Данные профиля и идентификаторы VK/Telegram хранятся до удаления аккаунта. Резервные копии, содержащие удалённые данные, автоматически перезаписываются не позднее 90 дней. Сведения о покупках, начислениях, списаниях и иные документы, необходимые для бухгалтерского и налогового учёта, хранятся 5 лет. Согласия, история принятия правил, обращения в поддержку, журналы безопасности и криптографический отпечаток удалённой платформенной идентичности хранятся 3 года после удаления аккаунта или завершения обращения. По истечении применимого срока данные удаляются либо обезличиваются, если законодательство не требует более длительного хранения."

APPLE_WALLET_ISSUER_URL=
GOOGLE_WALLET_ISSUER_URL=
ALLOW_DEMO=false
PIVNIK_DOCUMENT_PLATFORM=telegram

# Manual migration 023 + native receipt acceptance required before enabling new reservations.
# Existing holds continue reconciling even when new redemptions are disabled.
PIVNIK_POS_REDEMPTION_ENABLED=false

# PIVNIK Business sends broadcasts through this app; same value on admin-pilot. At least 32 characters.
BUSINESS_INTERNAL_TOKEN=
# Optional: app user id recorded as the sender of Business broadcasts (default: the first admin).
BUSINESS_BROADCAST_ACTOR_USER_ID=

# SPACEVERSE dedicated tenant API. Default-off; no legacy DATABASE_URL/secret fallback.
# Requires manually prepared migration 022 and an unexpired scoped launch permission.
SPACEVERSE_ENABLE_TENANT_SERVICE=false
SPACEVERSE_RUNTIME_DATABASE_URL=
SPACEVERSE_RUNTIME_SESSION_SECRET=
SPACEVERSE_RUNTIME_APPROVED_IMAGE_ID=
SPACEVERSE_RUNTIME_LAUNCH_AUTHORIZATION_ID=
SPACEVERSE_RUNTIME_LAUNCH_KEY=
SPACEVERSE_TELEGRAM_BOT_TOKEN=
SPACEVERSE_VK_APP_ID=
SPACEVERSE_VK_APP_SECRET=

# Optional standalone CRM activation preflight; no subscription or venue activation.
ADMIN_ENABLE_TENANT_CRM_ACTIVATION_CHECKS=false

# Optional standalone CRM metadata preparation; no guest application or activation.
ADMIN_ENABLE_CRM_ONBOARDING=false

# Internal onboarding support queue; manual admin migration 017 required.
ADMIN_ENABLE_ONBOARDING_SUPPORT=false
ADMIN_ENABLE_ONBOARDING_DATABASE_BOOTSTRAP=false

# Owner beer intake: server-only Evotor references; no browser credentials.
# Absolute quantity PATCH is not safe against terminal sales. These flags do not
# bypass the server concurrency gate; a supported safe provider contract is required.
ADMIN_ENABLE_BEER_INTAKE=false
ADMIN_ENABLE_EVOTOR_STOCK_WRITES=false
