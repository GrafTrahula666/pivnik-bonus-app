<?xml version="1.0" encoding="utf-8"?>
<!--
  Every action and permission string below is taken from the constants in
  evotor/integration-library v0.6.40 (see evotor-bridge/README.md for the source of each).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- SellIntegrationService.PERMISSION -->
    <uses-permission android:name="ru.evotor.permission.SELL_INTEGRATION_SERVICE" />
    <uses-permission android:name="ru.evotor.devices.SCANNER_RECEIVER" />

    <queries>
        <!-- ReceiptApi.AUTHORITY / AUTHORITY_V2: read the open and closed sell receipt -->
        <provider android:authorities="ru.evotor.evotorpos.receipt" />
        <provider android:authorities="ru.evotor.evotorpos.v2.receipt" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="PIVNIK для Эвотора"
        android:usesCleartextTraffic="false">

        <!-- Issued for the application in the Evotor developer account; injected at build time. -->
        <meta-data
            android:name="app_uuid"
            android:value="${evotorAppUuid}" />

        <activity
            android:name=".CustomerScanActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Evotor's own launcher hides LAUNCHER-only apps; this puts the setup screen on the terminal. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.EVOTOR" />
            </intent-filter>
            <!-- Tile colour on the terminal home screen (HEX, never white). Key name from Evotor's
                 "Вызов приложения из интерфейса смарт-терминала"; confirm against that page on a real till. -->
            <meta-data
                android:name="ru.evotor.launcher.BACKGROUND_COLOR"
                android:value="#08040E" />
        </activity>

        <activity android:name=".SettingsActivity" android:exported="false" />
        <activity android:name=".NativeCustomerActivity" android:exported="true"
            android:theme="@android:style/Theme.Material.Dialog.Alert" />
        <activity android:name=".RedemptionActivity" android:exported="true" />

        <!-- Official receipt-discount integration: native tile beside payment options. -->
        <service android:name=".RedemptionService" android:enabled="true" android:exported="true"
            android:icon="@mipmap/ic_launcher_round" android:label="Списать баллы">
            <meta-data android:name="ru.evotor.sales_screen.BACKGROUND_COLOR" android:value="#272135" />
            <intent-filter>
                <action android:name="evo.v2.receipt.sell.receiptDiscount" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="evo.v2.receipt.sell.beforePositionsEdited" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <!-- SellIntegrationService.ACTION_BARCODE_RECEIVED -->
        <!-- Evotor's barcode-event page lists category EVOTOR and this permission; the generic manifest page lists DEFAULT, so both filters are declared. -->
        <service
            android:name=".PivnikSellService"
            android:exported="true"
            android:permission="ru.evotor.permission.SELL_INTEGRATION_SERVICE">
            <intent-filter>
                <action android:name="ru.evotor.event.sell.BARCODE_RECEIVED" />
                <category android:name="android.intent.category.EVOTOR" />
            </intent-filter>
            <intent-filter>
                <action android:name="ru.evotor.event.sell.BARCODE_RECEIVED" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <!-- SellReceiptBroadcastReceiver.ACTION_RECEIPT_CREATED / _DELETED / _COMPLETED -->
        <receiver
            android:name=".PivnikReceiptReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="evotor.intent.action.receipt.sell.OPENED" />
                <action android:name="evotor.intent.action.receipt.sell.CLEARED" />
                <action android:name="evotor.intent.action.receipt.sell.RECEIPT_CLOSED" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
