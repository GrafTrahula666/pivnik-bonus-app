NODE_ENV=development
PORT=4174

# Admin-owned metadata/config/auth/audit tables.
ADMIN_DATABASE_URL=postgresql://admin_metadata_writer:password@localhost:5432/pivnik_admin_dev

# Dedicated SELECT-only role over production legacy + Admin tenant mapping.
ADMIN_READ_DATABASE_URL=postgresql://admin_production_reader:password@localhost:5432/pivnik_admin_dev

# Public DB hosts require certificate AND hostname verification. URL TLS
# downgrades/host overrides and sslrootcert/sslcert/sslkey file paths are rejected.
# For a private CA, set NODE_EXTRA_CA_CERTS to its protected runtime file before
# starting Node. Never put private keys here; see ops/SPACEVERSE-DATABASE-TLS-RUNBOOK.md.
# NODE_EXTRA_CA_CERTS=/run/trust/database-ca.pem

# Dedicated least-privilege writer used ONLY for explicitly gated PIVNIK financial/reward mutations.
# Required grants: SELECT/UPDATE wallets, SELECT/INSERT transactions, relevant achievement/frame tables,
# plus Admin audit/idempotency tables so each sensitive mutation can be atomic.
ADMIN_PRODUCTION_WRITE_DATABASE_URL=

ADMIN_PUBLIC_ORIGIN=http://localhost:5173
ADMIN_CSRF_SECRET=replace-with-at-least-32-random-characters
ADMIN_ENABLE_ONBOARDING_DRAFTS=false
ADMIN_ENABLE_ONBOARDING_INTEGRATIONS=false
# When integrations are explicitly enabled, keep these values only in protected
# server-side secret stores. The keyring is JSON: {"v1":"<32-byte-base64-key>"}.
ADMIN_ONBOARDING_SECRET_ACTIVE_KEY_ID=
ADMIN_ONBOARDING_SECRET_KEYRING=
ADMIN_SESSION_TTL_HOURS=8
ADMIN_SECURE_COOKIES=false
ADMIN_TRUST_PROXY=true

# Phase C gates. Production defaults MUST remain false until pilot approval.
ADMIN_ENABLE_WRITES=true
ADMIN_ENABLE_PRODUCTION_BONUS_WRITES=false
ADMIN_ENABLE_PRODUCTION_ACHIEVEMENT_WRITES=false
ADMIN_ENABLE_PRODUCTION_ENTITLEMENT_WRITES=false
ADMIN_DEMO_ENABLED=true

# Explicit migration/bootstrap only.
ADMIN_ALLOW_MIGRATIONS=false
ADMIN_ALLOW_TEST_SEED=false

# Broadcasts: the guest app address and the token it expects (same BUSINESS_INTERNAL_TOKEN on both services).
PIVNIK_APP_URL=
BUSINESS_INTERNAL_TOKEN=

# Manual migration 011 and existing secure ADMIN_CSRF_SECRET are prerequisites.
# This does not activate/provision a venue or change Railway settings.
ADMIN_ENABLE_ONBOARDING_INVITATIONS=false

# Manual migration 012; persisted checkpoint/terminal/modules and server-owned statuses.
ADMIN_ENABLE_ONBOARDING_WORKFLOW=false
