{
  "name": "pivnik-admin-platform",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev:web": "vite --host 0.0.0.0",
    "dev:api": "tsx server/index.ts",
    "dev": "vite --host 0.0.0.0",
    "build:web": "vite build",
    "build:api": "tsc -p tsconfig.server.json",
    "build": "tsc -b && vite build && tsc -p tsconfig.server.json",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "start": "node dist-server/index.js",
    "db:migrate": "tsx server/migrate.ts",
    "admin:bootstrap": "tsx server/bootstrap-admin.ts",
    "seed:test-tenant": "tsx server/seed-test-tenant.ts",
    "staging:preflight": "node scripts/staging-preflight.mjs",
    "staging:verify": "node scripts/staging-verify.mjs",
    "staging:integration": "node scripts/run-staging-integration.mjs",
    "test": "vitest run",
    "test:security": "vitest run server/tests/security.test.ts server/tests/tenant-security.test.ts server/tests/write-security.test.ts",
    "test:integration": "vitest run server/tests/postgres.integration.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.2",
    "lucide-react": "^0.542.0",
    "recharts": "^3.1.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "vite": "^7.1.3",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "eslint": "^9.34.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.41.0",
    "vitest": "^3.2.4",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.5",
    "@playwright/test": "^1.55.0"
  }
}
